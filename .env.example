# ── Core ─────────────────────────────────────────────
# Public URL of the site, no trailing slash. Used in emails and payment callbacks.
APP_URL="http://localhost:3000"
# On Neon: DATABASE_URL = the pooled connection string, DIRECT_URL = the direct one.
DATABASE_URL="postgresql://aom:aom@localhost:5432/artofmarkets"
DIRECT_URL="postgresql://aom:aom@localhost:5432/artofmarkets"

# ── First admin account (created by `npm run db:seed`) ──
ADMIN_EMAIL="admin@artofmarkets.com"
ADMIN_PASSWORD="change-me-please-now"

# ── Payments ─────────────────────────────────────────
# "payhere" = PayHere (Sri Lanka), LKR + USD cards
# "off"     = paid programmes show "opening soon" (default in production)
# "mock"    = fake test checkout, no real money (default in development).
#             In production it only works with ALLOW_TEST_PAYMENTS="true".
PAYMENT_PROVIDER="mock"
ALLOW_TEST_PAYMENTS="false"
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
# "true" uses sandbox.payhere.lk
PAYHERE_SANDBOX="true"

# ── Email ────────────────────────────────────────────
# Without RESEND_API_KEY, emails are stored in the database and shown in Admin → Emails.
RESEND_API_KEY=""
EMAIL_FROM="Art of Markets <academy@artofmarkets.com>"
EMAIL_REPLY_TO="academy@artofmarkets.com"
